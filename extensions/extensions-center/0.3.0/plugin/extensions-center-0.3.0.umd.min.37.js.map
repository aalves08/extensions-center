ed through Rancher, which needs a cluster-scoped ProxyEndpoint for api.github.com. You do not have permission to create one, so rebuilding the known extensions list will fail until a cluster administrator adds it.", "proxyError":"Could not set up the Rancher proxy for api.github.com: {message}", "manifestPr":({"prefix":"Official ext sync request :::", "view":"View PR", "draft":"(draft)", "noChange":"edits manifest.json", "more":"and {count} more", "change":({"added":"adds {extension} {versions}", "dropped":"drops {extension}", "newVersion":"{extension} +{versions}", "removedVersion":"{extension} -{versions}"})})}), "workflowTests":({"title":"Workflow Test Runs", "listTitle":"Extension Workflow Test Runs", "description":"Nightly runs of test-extension-workflows-master.yml in rancher/dashboard.", "empty":"No workflow test runs found.", "detailTitle":"Workflow test run #{runNumber}"}), "compatTests":({"title":"Compatibility Test Runs", "listTitle":"Extension Compatibility Test Runs", "description":"Runs of the extension compatibility test suite in rancher/dashboard.", "empty":"No compatibility test runs found.", "detailTitle":"Compatibility test run #{runNumber}"}), "runs":({"cols":({"runId":"Run ID", "link":"GitHub", "status":"Status", "overallStatus":"Overall Status", "total":"Tests", "passed":"Passed", "skipped":"Skipped", "failed":"Failed", "branch":"Branch", "event":"Trigger", "actor":"Actor", "started":"Started", "duration":"Duration"}), "detail":({"overview":"Overview", "jobs":"Jobs", "workflow":"Workflow", "commit":"Commit", "commitMessage":"Commit Message", "attempt":"Attempt", "triggeringActor":"Triggering Actor", "sha":"Commit SHA", "jobName":"Job", "jobStatus":"Status", "jobDuration":"Duration", "steps":"Steps", "stepName":"Step", "stepStatus":"Status", "stepDuration":"Duration", "noJobs":"This run reported no jobs.", "noSteps":"This job ran no steps."})}), "officialRepos":({"title":"Official Extension Repos", "description":"Repos listed in the rancher/ui-plugin-charts manifest.", "empty":"No official extension repos found.", "cols":({"name":"Extension", "headBranch":"Head<br>Branch", "shellVersion":"@rancher/shell", "componentsVersion":"@rancher/<br>components", "publishedVersion":"Published<br>(gh-pages)", "latestOfficial":"Latest<br>Official"}), "declaredTooltip":"The range declared in package.json on the head branch, not the version the latest release ships. Shell is compiled into an extension's bundle, so what shipped is whatever that release's lockfile resolved — the Security page's Shell upgrade tab reads it from there.", "outOfSync":"{published} is published on the extension's gh-pages branch, but the official charts still carry {official}."}), "knownRepos":({"title":"Known Extensions", "listTitle":"All Known Extensions", "description":"Community and official Rancher extension repos, ranked by popularity. The dashboard shows the top {count} community repos; the full list includes official ones.", "empty":"No known extension repos found.", "refreshCost":"Rebuilds from a full GitHub scan.", "notBuilt":"This list has not been built yet. Press Refresh to scan GitHub for extension repositories. The result is saved, so later visits load it without re-scanning.", "stale":"This list is over a month old. Press Refresh to rebuild it when you want current data.", "cols":({"name":"Name", "repo":"Repository", "description":"Description", "origin":"Origin", "aiCategory":"Category"}), "external":"External", "suse":"SUSE", "describe":({"action":"$$ Describe with AI", "waiting":"Describing…", "done":"Described", "failed":"Failed", "hint":"Reads each repo's README and writes it a one-line description and a category using the Claude provider configured in Settings. On the default model, claude-sonnet-4-6, that is about 450 input and 60 output tokens per repo — roughly a fifth of a US cent each, so about 20 cents for a 100-repo list at list prices. Opus 5 is around five times that.", "pending":"Next press: {describe} to describe,